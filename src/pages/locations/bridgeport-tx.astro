---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { MapPin, Phone, Mail, Clock, Star, Scale, ShieldCheck, ExternalLink } from 'lucide-react';

const breadcrumbItems = [
  { name: 'Locations', url: '/locations' },
  { name: 'Bridgeport Branch & Legal Team', url: '/locations/bridgeport-tx' },
];
---

<BaseLayout
  title="Wise County Title Co. Bridgeport Branch & The Berry White Law Firm"
  description="Bridgeport closing office and legal curative team at 1602 Halsell Street, Bridgeport, TX 76426. 4.9★ rating. Co-located with Attorney Herman Berry White IV, J.D."
  breadcrumbs={breadcrumbItems}
  pageType="location"
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="bg-gradient-to-b from-navy-950 to-navy-900 text-white py-14 sm:py-20 border-b border-gold-500/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-gold-500/20 text-gold-400 border border-gold-500/40">
        <Scale className="w-3.5 h-3.5" />
        <span>Escrow Closings & Co-Located Real Estate Legal Counsel</span>
      </div>

      <h1 class="font-serif font-bold text-3xl sm:text-5xl text-white">
        Bridgeport Branch Office & Legal Center
      </h1>

      <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
        1602 Halsell Street, Bridgeport, TX 76426. Serving Bridgeport, Runaway Bay, Lake Bridgeport, and West Wise County with escrow closings and direct on-site attorney curative support.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a href="tel:+19406833581" class="btn-gold text-xs flex items-center gap-1.5">
          <Phone className="w-4 h-4" /> Call Bridgeport: (940) 683-3581
        </a>
        <a 
          href="https://www.google.com/maps/search/?api=1&query=Wise+County+Title+Co+Bridgeport+TX&query_place_id=ChIJe7psacGKTYYRaltXNwLgaNM" 
          target="_blank" 
          rel="noopener" 
          class="btn-outline text-xs text-navy-950 bg-white flex items-center gap-1.5"
        >
          <span>Get Directions</span>
          <ExternalLink className="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <div class="lg:col-span-7 space-y-6">
          <h2 class="font-serif font-bold text-navy-950 text-2xl sm:text-3xl">
            Bridgeport Closing Suites & Legal Services
          </h2>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            Our Bridgeport office on Halsell Street serves West Wise County realtors, lakefront property owners, and ranchers. Co-located with <strong class="text-navy-950">The Berry White Law Firm, PLLC</strong>, we prepare deeds of trust, affidavits of heirship, and Lady Bird deeds directly in-house without outside delays.
          </p>

          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-4 text-xs">
            <div class="font-bold text-navy-950 text-sm">On-Site Real Estate Legal Team:</div>
            <div>
              <div class="font-bold text-slate-900 text-sm">Herman "Berry" White IV, J.D.</div>
              <div class="text-slate-500">Vice President & Real Estate Attorney (Texas Bar #24060820)</div>
              <p class="text-slate-600 mt-2">
                Specializing in Texas deed preparation, curative title resolution, series LLCs, and estate planning.
              </p>
              <div class="pt-3">
                <a href="https://www.hbwhitelaw.com/" target="_blank" rel="noopener" class="text-xs font-bold text-gold-600 hover:underline inline-flex items-center gap-1">
                  Visit The Berry White Law Firm Website <ExternalLink className="w-3 h-3" />
                </a>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-navy-900 text-white p-8 rounded-3xl border border-gold-500/30 space-y-4 text-xs shadow-xl">
          <div class="font-serif font-bold text-xl text-white">Bridgeport Office Details</div>
          <div class="space-y-2 text-slate-300">
            <p><strong>Physical Address:</strong> 1602 Halsell Street, Bridgeport, TX 76426</p>
            <p><strong>Phone:</strong> (940) 683-3581</p>
            <p><strong>Attorney Line:</strong> (940) 647-0000</p>
            <p><strong>Fast Response Email:</strong> fastresponse@wisetitle.com</p>
            <p><strong>Hours:</strong> Monday – Friday: 8:00 AM – 5:00 PM</p>
            <p><strong>Google Place ID:</strong> ChIJe7psacGKTYYRaltXNwLgaNM</p>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
