---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { Building, MapPin, Phone, ExternalLink, ShieldCheck, FileText, ArrowRight } from 'lucide-react';

export async function getStaticPaths() {
  const counties = await getCollection('counties');
  return counties.map((c) => ({
    params: { county: c.slug },
    props: { countyData: c },
  }));
}

const { countyData } = Astro.props;
const { Content } = await countyData.render();

const breadcrumbItems = [
  { name: 'Locations & Counties', url: '/locations' },
  { name: `${countyData.data.countyName} Real Estate Guide`, url: `/locations/${countyData.slug}` },
];
---

<BaseLayout
  title={`${countyData.data.countyName} Real Estate Closing & Title Guide | Wise County Title`}
  description={`Comprehensive real estate closing, tax appraisal, and county recording guide for ${countyData.data.countyName}, Texas.`}
  breadcrumbs={breadcrumbItems}
  pageType="location"
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="bg-gradient-to-b from-navy-950 to-navy-900 text-white py-14 sm:py-20 border-b border-gold-500/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <span class="badge-gold">Texas County Authority Hub</span>
      <h1 class="font-serif font-bold text-3xl sm:text-5xl text-white">
        {countyData.data.countyName} Real Estate Settlement Guide
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl leading-relaxed">
        {countyData.data.overview}
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="prose prose-slate prose-lg max-w-none text-slate-800 leading-relaxed space-y-4">
            <Content />
          </div>

          <div class="p-6 bg-white rounded-3xl border border-slate-200 shadow-sm space-y-3 text-xs sm:text-sm">
            <h2 class="font-serif font-bold text-navy-950 text-xl">Opening Title in {countyData.data.countyName}</h2>
            <p class="text-slate-600">
              Wise County Title Company coordinates seamlessly with county clerk offices, appraisal districts, and municipal taxing entities across {countyData.data.countyName}.
            </p>
            <div class="pt-2">
              <a href="/order" class="btn-gold text-xs inline-flex items-center gap-1.5">
                <FileText className="w-4 h-4" /> Drop Contract for {countyData.data.countyName}
              </a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-card space-y-4 text-xs">
          <div class="font-serif font-bold text-navy-950 text-lg border-b border-slate-200 pb-2">
            {countyData.data.countyName} Quick Reference
          </div>

          <div class="space-y-2.5 text-slate-700">
            <div>
              <span class="text-slate-500 font-semibold block uppercase text-[10px]">County Seat:</span>
              <strong class="text-navy-900 text-sm">{countyData.data.countySeat}</strong>
            </div>

            <div>
              <span class="text-slate-500 font-semibold block uppercase text-[10px]">Appraisal District:</span>
              <div class="font-bold text-navy-900">{countyData.data.cadName}</div>
              <div class="text-slate-500">{countyData.data.cadAddress}</div>
              <a href={countyData.data.cadUrl} target="_blank" rel="noopener" class="text-gold-600 hover:underline font-semibold inline-flex items-center gap-1 mt-0.5">
                Visit CAD Website <ExternalLink className="w-3 h-3" />
              </a>
            </div>

            <div>
              <span class="text-slate-500 font-semibold block uppercase text-[10px]">Clerk Recording Fees:</span>
              <div class="font-bold text-slate-800">{countyData.data.clerkRecordingFees}</div>
            </div>

            <div>
              <span class="text-slate-500 font-semibold block uppercase text-[10px]">e-Recording Turnaround:</span>
              <div class="font-bold text-emerald-700">{countyData.data.eRecordingTurnaround}</div>
            </div>

            <div>
              <span class="text-slate-500 font-semibold block uppercase text-[10px]">Typical Property Tax Rate:</span>
              <div class="font-bold text-slate-800">{countyData.data.typicalTaxRate}</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
