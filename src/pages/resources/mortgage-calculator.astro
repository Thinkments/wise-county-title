---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import MortgageCalculator from '../../components/interactive-suite/calculators/MortgageCalculator';

const breadcrumbItems = [
  { name: 'Resources', url: '/resources' },
  { name: 'Mortgage Calculator', url: '/resources/mortgage-calculator' },
];
---

<BaseLayout
  title="Texas Mortgage & Amortization Calculator | Wise County Title"
  description="Estimate monthly mortgage payments including principal, interest, Wise County property taxes, and insurance."
  breadcrumbs={breadcrumbItems}
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <MortgageCalculator client:load />
  </section>
</BaseLayout>
