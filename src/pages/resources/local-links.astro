---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { ExternalLink, Building, Landmark, Compass, Droplet } from 'lucide-react';

const breadcrumbItems = [
  { name: 'Resources', url: '/resources' },
  { name: 'Local Government & Utility Links', url: '/resources/local-links' },
];

const LOCAL_LINKS = [
  {
    category: 'Wise County Government & Appraisal',
    links: [
      { name: 'Wise County Appraisal District (Wise CAD)', url: 'https://www.wisecad.org/', desc: 'Property tax searches, homestead exemptions, and 1-d-1 ag applications.' },
      { name: 'Wise County Clerk Official Records', url: 'https://www.co.wise.tx.us/', desc: 'Public property records, deed filings, and plat maps.' },
      { name: 'Wise County Tax Assessor-Collector', url: 'https://www.co.wise.tx.us/', desc: 'Property tax payment certificates and vehicle registrations.' },
    ],
  },
  {
    category: 'Water Districts & Environmental',
    links: [
      { name: 'Upper Trinity Groundwater Conservation District', url: 'https://uppertrinitygcd.com/', desc: 'Private water well permits, rules, and spacing regulations in Wise, Parker, and Montague.' },
      { name: 'Tarrant Regional Water District (TRWD)', url: 'https://www.trwd.com/', desc: 'Lake Bridgeport flood control, reservoir management, and recreational permits.' },
      { name: 'Railroad Commission of Texas (RRC Public GIS)', url: 'https://www.rrc.texas.gov/', desc: 'Barnett Shale oil and gas well mapping and permit records.' },
    ],
  },
  {
    category: 'Legal & Title Regulators',
    links: [
      { name: 'Texas Department of Insurance (TDI Title Division)', url: 'https://www.tdi.texas.gov/', desc: 'Basic Manual of Rules, Rates, and Forms for the writing of Title Insurance in Texas.' },
      { name: 'The Berry White Law Firm, PLLC (H.B. White Law)', url: 'https://www.hbwhitelaw.com/', desc: 'In-house real estate attorney, probate, and curative legal services in Bridgeport, TX.' },
      { name: 'Texas Real Estate Commission (TREC)', url: 'https://www.trec.texas.gov/', desc: 'Promulgated contract forms, consumer notices, and broker license lookups.' },
    ],
  },
];
---

<BaseLayout
  title="Wise County Local Government & Real Estate Links | Wise Title"
  description="Helpful public records, appraisal district, groundwater conservation, and municipal links for Wise County real estate transactions."
  breadcrumbs={breadcrumbItems}
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="bg-gradient-to-b from-navy-950 to-navy-900 text-white py-14 sm:py-20 border-b border-gold-500/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="badge-gold">Verified Public Resources</span>
      <h1 class="font-serif font-bold text-3xl sm:text-5xl text-white">
        Wise County & Regional Resource Directory
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Direct links to appraisal districts, water authorities, county clerk recording portals, and state regulatory boards.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-surface">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {LOCAL_LINKS.map((cat) => (
        <div class="space-y-4">
          <h2 class="font-serif font-bold text-navy-950 text-2xl border-b border-slate-200 pb-2">
            {cat.category}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {cat.links.map((lnk) => (
              <a 
                href={lnk.url}
                target="_blank"
                rel="noopener noreferrer"
                class="card-premium space-y-2 hover:border-gold-500 transition-colors group block"
              >
                <div class="font-bold text-navy-950 text-sm group-hover:text-gold-600 transition-colors flex items-center justify-between">
                  <span>{lnk.name}</span>
                  <ExternalLink className="w-3.5 h-3.5 text-slate-400 group-hover:text-gold-600" />
                </div>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {lnk.desc}
                </p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
