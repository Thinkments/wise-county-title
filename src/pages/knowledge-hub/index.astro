---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { KNOWLEDGE_PILLARS, MASTER_300_TOPICS } from '../../lib/knowledge-taxonomy';
import { 
  BookOpen, 
  Search, 
  Sparkles, 
  ArrowRight, 
  CheckCircle2, 
  ShieldCheck, 
  Filter, 
  Layers,
  Scale
} from 'lucide-react';
---

<BaseLayout
  title="300-Page Real Estate Title & Settlement Knowledge Engine | Wise County Title"
  description="The definitive real estate research hub for Texas property owners, realtors, lenders, commercial developers, and agricultural investors. 300 authoritative guides."
  pageType="website"
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-navy-950 via-navy-900 to-navy-900 text-white py-14 sm:py-20 border-b border-gold-500/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-gold-500/20 text-gold-400 border border-gold-500/40">
        <Sparkles className="w-3.5 h-3.5" />
        <span>300-Page Research & Education Engine</span>
      </div>

      <h1 class="font-serif font-bold text-3xl sm:text-5xl text-white tracking-tight">
        The Texas Title & Land Research Hub
      </h1>

      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Curated and verified by our in-house underwriting examiners and real estate attorneys. Search 300 deep-dive guides covering closing mechanics, TDI rates, ag valuations, mineral severance, commercial platting, and curative lien clearance.
      </p>

      <!-- Search Input UI -->
      <div class="max-w-xl mx-auto pt-4">
        <div class="relative">
          <Search className="w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2" />
          <input 
            type="text"
            id="knowledge-search"
            placeholder="Search 300 topics (e.g. 1-d-1 Ag, Lady Bird Deed, T-47, Lis Pendens)..."
            class="w-full pl-12 pr-4 py-3.5 rounded-2xl bg-white text-slate-900 placeholder-slate-400 font-medium text-sm focus:outline-none focus:ring-2 focus:ring-gold-500 shadow-xl"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- 6 Pillar Hub Categories Grid -->
  <section class="py-14 sm:py-18 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 pb-4">
        <div>
          <span class="badge-gold">6 Research Pillars</span>
          <h2 class="font-serif font-bold text-navy-950 text-2xl sm:text-3xl mt-1">
            Browse by Domain Expertise
          </h2>
        </div>
        <div class="text-xs text-slate-500 font-medium">
          300 Total Pages Across All Pillars
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {KNOWLEDGE_PILLARS.map((pillar) => (
          <div class="card-premium flex flex-col justify-between space-y-5 hover:border-navy-900 group">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-3xl">{pillar.icon}</span>
                <span class="badge-pillar text-[10px]">{pillar.pageCount} Pages</span>
              </div>

              <h3 class="font-serif font-bold text-navy-950 text-xl group-hover:text-gold-700 transition-colors">
                {pillar.name}
              </h3>

              <p class="text-xs text-slate-600 leading-relaxed">
                {pillar.description}
              </p>

              <!-- Sub-cluster list -->
              <ul class="space-y-1 text-[11px] text-slate-500 pt-2 border-t border-slate-100">
                {pillar.subClusters.map((sc) => (
                  <li class="flex items-center gap-1.5">
                    <CheckCircle2 className="w-3 h-3 text-gold-600 shrink-0" />
                    <span>{sc}</span>
                  </li>
                ))}
              </ul>
            </div>

            <a 
              href={`/knowledge-hub/${pillar.slug}`}
              class="w-full btn-outline text-xs flex items-center justify-center gap-1.5 group-hover:bg-navy-900 group-hover:text-white group-hover:border-navy-900 transition-all"
            >
              <span>Explore {pillar.name}</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Complete 300-Page Master Catalog Explorer -->
  <section class="py-14 sm:py-18 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="badge-gold">Interactive Directory</span>
          <h2 class="font-serif font-bold text-navy-950 text-2xl sm:text-3xl mt-1">
            Featured Research Topics & Guides
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1">
            Click any guide to read full technical analysis, statutory basis, and closing procedures.
          </p>
        </div>

        <!-- Filter tabs -->
        <div class="flex flex-wrap gap-1.5 text-xs font-semibold">
          <button class="px-3 py-1.5 rounded-lg bg-navy-900 text-white shadow-sm">All Topics</button>
          <a href="/knowledge-hub/homeowner" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200">Homeowner</a>
          <a href="/knowledge-hub/realtor" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200">Realtor</a>
          <a href="/knowledge-hub/ag-ranch" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200">Ag & Ranch</a>
          <a href="/knowledge-hub/commercial" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200">Commercial</a>
          <a href="/knowledge-hub/title-clearance" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200">Title Clearance</a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="topic-grid">
        {MASTER_300_TOPICS.map((topic) => (
          <a 
            href={`/knowledge-hub/${topic.pillar}/${topic.slug}`}
            class="p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-navy-900 hover:bg-white shadow-sm hover:shadow-card transition-all group flex flex-col justify-between space-y-3"
          >
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-[11px]">
                <span class="font-bold text-gold-600 uppercase tracking-wider">{topic.subCluster}</span>
                <span class="text-slate-400 capitalize">{topic.assetClass.replace('-', ' ')}</span>
              </div>
              <h3 class="font-serif font-bold text-navy-950 text-base group-hover:text-gold-700 transition-colors leading-snug">
                {topic.title}
              </h3>
              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                {topic.summary}
              </p>
            </div>

            <div class="pt-2 border-t border-slate-200/60 flex items-center justify-between text-xs font-semibold text-navy-900 group-hover:text-gold-600">
              <span>Read Full Guide</span>
              <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>
</BaseLayout>

<script>
  // Simple client-side instant filter for 300 topics
  const searchInput = document.getElementById('knowledge-search') as HTMLInputElement | null;
  const topicGrid = document.getElementById('topic-grid');

  if (searchInput && topicGrid) {
    searchInput.addEventListener('input', (e) => {
      const query = (e.target as HTMLInputElement).value.toLowerCase();
      const cards = topicGrid.querySelectorAll('a');

      cards.forEach((card) => {
        const text = card.textContent?.toLowerCase() || '';
        if (text.includes(query)) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  }
</script>
