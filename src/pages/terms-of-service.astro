---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';

const breadcrumbItems = [
  { name: 'Terms of Service', url: '/terms-of-service' },
];
---

<BaseLayout
  title="Terms of Service | Wise County Title Company"
  description="Terms and conditions governing the use of Wise County Title Company online calculation tools, GIS map layers, and website resources."
  breadcrumbs={breadcrumbItems}
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-6 prose prose-slate">
    <h1 class="font-serif font-bold text-navy-950 text-3xl sm:text-4xl">Terms of Service & Disclaimers</h1>
    <p class="text-xs text-slate-500">Effective Date: August 2026</p>

    <h2>1. Acceptance of Terms</h2>
    <p>
      By accessing or using the Wise County Title Company website, interactive calculation tools, T-47 affidavit generators, and GIS map layers, you agree to be bound by these Terms of Service.
    </p>

    <h2>2. Estimator & Calculator Disclaimers</h2>
    <p>
      Calculations generated by our Texas Department of Insurance (TDI) Rate Calculator, Seller Net Sheet, and Mortgage Calculator are provided for informational estimation purposes only. Final title insurance premiums, endorsement fees, and closing costs are determined by the formal Title Commitment and Closing Disclosure issued by your escrow officer.
    </p>

    <h2>3. Legal Advice Disclaimer</h2>
    <p>
      Educational articles and website tools do not constitute formal legal counsel. For specific legal representation, deed drafting, or probate guidance, consult licensed counsel at <a href="https://www.hbwhitelaw.com/" target="_blank" rel="noopener">The Berry White Law Firm, PLLC</a> or your independent attorney.
    </p>
  </article>
</BaseLayout>
