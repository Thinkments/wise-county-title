---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import { MapPin, Phone, Mail, Clock, Send, Star, ExternalLink, ShieldCheck } from 'lucide-react';

const breadcrumbItems = [
  { name: 'Contact Us', url: '/contact' },
];
---

<BaseLayout
  title="Contact Wise County Title Company | Decatur & Bridgeport Offices"
  description="Contact Wise County Title Company in Decatur, TX (940) 627-3581 and Bridgeport, TX (940) 683-3581. Escrow orders, title plant inquiries, and closings."
  breadcrumbs={breadcrumbItems}
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="bg-gradient-to-b from-navy-950 to-navy-900 text-white py-14 sm:py-20 border-b border-gold-500/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <span class="badge-gold">Always at Your Service</span>
      <h1 class="font-serif font-bold text-3xl sm:text-5xl text-white">
        Contact Wise County Title Company
      </h1>
      <p class="text-slate-300 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Reach our escrow officers, sovereignty title examiners, and legal team in Decatur and Bridgeport.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left: Office Locations -->
        <div class="lg:col-span-6 space-y-6">
          
          <!-- Decatur Office -->
          <div class="card-premium space-y-4 border-2">
            <div class="flex items-start justify-between">
              <div>
                <span class="badge-gold text-[10px]">Headquarters & Sovereignty Plant</span>
                <h2 class="font-serif font-bold text-navy-950 text-2xl mt-1">Decatur Office</h2>
              </div>
              <div class="flex items-center gap-1 text-gold-500 text-xs font-bold">
                <Star className="w-4 h-4 fill-gold-500" />
                <span>4.9★ (217+ Reviews)</span>
              </div>
            </div>

            <div class="space-y-2 text-xs text-slate-700">
              <p class="flex items-start gap-2">
                <MapPin className="w-4 h-4 text-gold-600 shrink-0 mt-0.5" />
                <span>405 Park West Court, Decatur, TX 76234</span>
              </p>
              <p class="flex items-center gap-2">
                <Phone className="w-4 h-4 text-gold-600 shrink-0" />
                <a href="tel:+19406273581" class="font-bold text-navy-900 hover:underline">(940) 627-3581</a>
              </p>
              <p class="flex items-center gap-2">
                <Mail className="w-4 h-4 text-gold-600 shrink-0" />
                <span>orderdesk@wisetitle.com</span>
              </p>
              <p class="flex items-center gap-2">
                <Clock className="w-4 h-4 text-gold-600 shrink-0" />
                <span>Monday–Friday: 8:00 AM – 5:00 PM</span>
              </p>
            </div>
          </div>

          <!-- Bridgeport Office -->
          <div class="card-premium space-y-4 border-2">
            <div class="flex items-start justify-between">
              <div>
                <span class="badge-gold text-[10px]">Branch & The Berry White Law Firm</span>
                <h2 class="font-serif font-bold text-navy-950 text-2xl mt-1">Bridgeport Office</h2>
              </div>
              <div class="flex items-center gap-1 text-gold-500 text-xs font-bold">
                <Star className="w-4 h-4 fill-gold-500" />
                <span>4.9★ (28+ Reviews)</span>
              </div>
            </div>

            <div class="space-y-2 text-xs text-slate-700">
              <p class="flex items-start gap-2">
                <MapPin className="w-4 h-4 text-gold-600 shrink-0 mt-0.5" />
                <span>1602 Halsell Street, Bridgeport, TX 76426</span>
              </p>
              <p class="flex items-center gap-2">
                <Phone className="w-4 h-4 text-gold-600 shrink-0" />
                <a href="tel:+19406833581" class="font-bold text-navy-900 hover:underline">(940) 683-3581</a>
              </p>
              <p class="flex items-center gap-2">
                <Mail className="w-4 h-4 text-gold-600 shrink-0" />
                <span>fastresponse@wisetitle.com</span>
              </p>
              <p class="flex items-center gap-2">
                <Clock className="w-4 h-4 text-gold-600 shrink-0" />
                <span>Monday–Friday: 8:00 AM – 5:00 PM</span>
              </p>
            </div>
          </div>

        </div>

        <!-- Right: Inquiry Form -->
        <div class="lg:col-span-6 bg-white p-8 rounded-3xl border border-slate-200 shadow-card space-y-6">
          <div class="space-y-1">
            <span class="badge-gold">Direct Contact Form</span>
            <h2 class="font-serif font-bold text-navy-950 text-2xl">Send a Message</h2>
            <p class="text-xs text-slate-600">Our escrow officers respond to all inquiries within 1 business hour.</p>
          </div>

          <form 
            id="contact-form"
            name="contact-inquiry" 
            method="POST" 
            data-netlify="true" 
            netlify-honeypot="bot-field"
            class="space-y-4 text-xs" 
          >
            <input type="hidden" name="form-name" value="contact-inquiry" />
            <p class="hidden">
              <label>Don’t fill this out: <input name="bot-field" /></label>
            </p>
            
            <div id="form-success-banner" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 space-y-1">
              <div class="font-bold flex items-center gap-1.5">
                <svg class="w-4 h-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Message Received!
              </div>
              <p class="text-xs text-emerald-800">
                Thank you for contacting Wise County Title Company. An escrow officer will respond within 1 business hour (or directly to your email).
              </p>
            </div>

            <div id="form-fields" class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="space-y-1">
                  <label class="font-semibold text-slate-700">Full Name *</label>
                  <input type="text" name="name" required placeholder="Jane Doe" class="w-full p-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-gold-500" />
                </div>
                <div class="space-y-1">
                  <label class="font-semibold text-slate-700">Phone Number *</label>
                  <input type="tel" name="phone" required placeholder="(940) 555-0123" class="w-full p-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-gold-500" />
                </div>
              </div>

              <div class="space-y-1">
                <label class="font-semibold text-slate-700">Email Address *</label>
                <input type="email" name="email" required placeholder="jane@example.com" class="w-full p-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-gold-500" />
              </div>

              <div class="space-y-1">
                <label class="font-semibold text-slate-700">Inquiry Topic</label>
                <select name="topic" class="w-full p-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-gold-500">
                  <option value="General Escrow or Closing Inquiry">General Escrow or Closing Inquiry</option>
                  <option value="Sovereignty Title Plant Records Search">Sovereignty Title Plant Records Search</option>
                  <option value="Curative Legal Assistance (Berry White Law)">Curative Legal Assistance (Berry White Law)</option>
                  <option value="Commercial Development & ALTA Endorsements">Commercial Development & ALTA Endorsements</option>
                  <option value="Farm & Ranch 1-d-1 Valuation Question">Farm & Ranch 1-d-1 Valuation Question</option>
                </select>
              </div>

              <div class="space-y-1">
                <label class="font-semibold text-slate-700">Message / Transaction Details</label>
                <textarea name="message" rows="4" placeholder="Provide property address or transaction details..." class="w-full p-2.5 rounded-xl border border-slate-300 focus:outline-none focus:ring-2 focus:ring-gold-500"></textarea>
              </div>

              <button id="submit-btn" type="submit" class="w-full btn-gold text-xs py-3 flex items-center justify-center gap-2">
                <Send className="w-4 h-4" /> Send Message
              </button>
            </div>
          </form>

          <script is:inline>
            const form = document.getElementById('contact-form');
            if (form) {
              form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const submitBtn = document.getElementById('submit-btn');
                if (submitBtn) {
                  submitBtn.disabled = true;
                  submitBtn.innerText = 'Sending...';
                }

                const formData = new FormData(form);
                const dataObj = Object.fromEntries(formData.entries());

                try {
                  // 1. Submit to Netlify Forms endpoint
                  await fetch('/', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams(formData).toString(),
                  });

                  // 2. Dispatch to custom webhook if configured
                  const webhookUrl = window.localStorage.getItem('WISE_WEBHOOK_URL');
                  if (webhookUrl) {
                    await fetch(webhookUrl, {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        eventType: 'contact_inquiry',
                        timestamp: new Date().toISOString(),
                        sourceUrl: window.location.href,
                        data: dataObj,
                      }),
                    }).catch(() => {});
                  }

                  // 3. Save to local activity log
                  const activityLog = JSON.parse(window.localStorage.getItem('WISE_ACTIVITY_LOG') || '[]');
                  activityLog.unshift({
                    eventType: 'contact_inquiry',
                    timestamp: new Date().toISOString(),
                    data: dataObj,
                  });
                  window.localStorage.setItem('WISE_ACTIVITY_LOG', JSON.stringify(activityLog.slice(0, 50)));

                  // Show success banner
                  const banner = document.getElementById('form-success-banner');
                  const fields = document.getElementById('form-fields');
                  if (banner && fields) {
                    fields.classList.add('hidden');
                    banner.classList.remove('hidden');
                  }
                } catch (err) {
                  alert('Thank you for contacting Wise County Title Company. Your message has been recorded.');
                }
              });
            }
          </script>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>
