---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { 
  Scale, 
  ShieldCheck, 
  ExternalLink, 
  FileText, 
  CheckCircle2, 
  PhoneCall, 
  Mail, 
  Clock, 
  ArrowRight,
  Sparkles
} from 'lucide-react';

const breadcrumbItems = [
  { name: 'Services', url: '/services' },
  { name: 'Curative Legal Counsel (H.B. White Law)', url: '/services/curative-legal-counsel' },
];
---

<BaseLayout
  title="In-House Real Estate Legal Counsel & Curative Services | The Berry White Law Firm, PLLC"
  description="Wise County Title pairs escrow operations with in-house legal counsel at The Berry White Law Firm, PLLC in Bridgeport, TX. Rapid deed drafting, heirship affidavits, and title defect resolution."
  breadcrumbs={breadcrumbItems}
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <section class="bg-gradient-to-b from-navy-950 to-navy-900 text-white py-14 sm:py-20 border-b border-gold-500/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-gold-500/20 text-gold-400 border border-gold-500/40">
        <Scale className="w-3.5 h-3.5" />
        <span>In-House Legal Partnership</span>
      </div>

      <h1 class="font-serif font-bold text-3xl sm:text-5xl text-white">
        Curative Title Counsel & Real Estate Legal Services
      </h1>

      <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        Eliminate closing delays and contract terminations. Through our partnership with <strong class="text-white">The Berry White Law Firm, PLLC</strong>, Wise County Title resolves complex title clouds, unprobated wills, and custom deed drafting in-house.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a 
          href="https://www.hbwhitelaw.com/" 
          target="_blank" 
          rel="noopener noreferrer"
          class="btn-gold text-xs flex items-center gap-1.5"
        >
          <span>Visit The Berry White Law Firm (hbwhitelaw.com)</span>
          <ExternalLink className="w-3.5 h-3.5" />
        </a>
        <a href="/tools/deal-doctor" class="btn-outline text-xs text-navy-950 bg-white">
          Submit Deal Doctor Scenario →
        </a>
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Attorney Profile Card -->
      <div class="bg-white rounded-3xl border border-slate-200 p-8 sm:p-10 shadow-card grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <span class="badge-gold">Principal Real Estate Legal Counsel</span>
          <h2 class="font-serif font-bold text-navy-950 text-2xl sm:text-3xl">
            Herman "Berry" White IV, J.D.
          </h2>
          <div class="text-xs font-semibold text-slate-500">
            Texas Bar License #24060820 • Vice President & Co-Owner, Wise County Title Company
          </div>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
            Berry White brings extensive Texas real estate, business structuring, and estate planning expertise to every transaction. Co-located at Wise County Title's Bridgeport closing facility, Berry White Law works hand-in-hand with escrow examiners to draft legal curative instruments instantly.
          </p>
          <div class="flex flex-wrap gap-2 pt-2 text-xs">
            <span class="px-3 py-1 bg-navy-50 text-navy-900 font-semibold rounded-lg">Texas Real Estate Law</span>
            <span class="px-3 py-1 bg-navy-50 text-navy-900 font-semibold rounded-lg">Probate & Heirship</span>
            <span class="px-3 py-1 bg-navy-50 text-navy-900 font-semibold rounded-lg">Series LLC & Business</span>
            <span class="px-3 py-1 bg-navy-50 text-navy-900 font-semibold rounded-lg">Mineral & Surface Rights</span>
          </div>
        </div>

        <div class="lg:col-span-4 bg-navy-900 text-white p-6 rounded-2xl border border-navy-800 space-y-3 text-xs">
          <div class="font-bold text-gold-400 text-sm">Bridgeport Law Office</div>
          <p class="text-slate-300">Co-located with Wise County Title Bridgeport closing suites.</p>
          <div class="space-y-1 text-[11px] text-slate-300 pt-2 border-t border-navy-800">
            <div>📍 1602 Halsell Street, Bridgeport, TX 76426</div>
            <div>📞 Direct Phone: (940) 647-0000</div>
            <div>✉️ Email: white@hbwhitelaw.com</div>
          </div>
        </div>
      </div>

      <!-- Practice Areas Grid -->
      <div class="space-y-6">
        <h2 class="font-serif font-bold text-navy-950 text-2xl">
          Direct Legal Services for Real Estate Transactions
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="card-premium space-y-3">
            <h3 class="font-serif font-bold text-navy-950 text-lg">Probate & Estate Transfers</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Affidavits of Heirship (Texas Estates Code §203), Muniment of Title, Letters Testamentary review, and custom Texas Lady Bird Deeds (Enhanced Life Estate Deeds).
            </p>
            <a href="https://www.hbwhitelaw.com/areas-of-practice/estate-planning" target="_blank" rel="noopener" class="text-xs text-gold-600 font-bold inline-flex items-center gap-1">
              Estate Planning Services <ExternalLink className="w-3 h-3" />
            </a>
          </div>

          <div class="card-premium space-y-3">
            <h3 class="font-serif font-bold text-navy-950 text-lg">Deed Preparation & Curative</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Special & General Warranty Deeds, Owelty Liens for divorce equity buyouts, Boundary Line Agreements, correction instruments, and statute of limitations lien releases.
            </p>
            <a href="https://www.hbwhitelaw.com/areas-of-practice/real-estate" target="_blank" rel="noopener" class="text-xs text-gold-600 font-bold inline-flex items-center gap-1">
              Real Estate Legal Services <ExternalLink className="w-3 h-3" />
            </a>
          </div>

          <div class="card-premium space-y-3">
            <h3 class="font-serif font-bold text-navy-950 text-lg">Business & Entity Formation</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Texas LLC and Series LLC formation for real estate syndicators, operating agreements, corporate resolutions, and joint venture developer contracts.
            </p>
            <a href="https://www.hbwhitelaw.com/areas-of-practice/business-law" target="_blank" rel="noopener" class="text-xs text-gold-600 font-bold inline-flex items-center gap-1">
              Business Law Services <ExternalLink className="w-3 h-3" />
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>
</BaseLayout>
