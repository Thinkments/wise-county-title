---
import { ArrowRight, Calculator, FileText, Compass, Sparkles, Scale } from 'lucide-react';

interface Props {
  persona?: 'homeowner' | 'realtor' | 'ag-ranch' | 'commercial' | 'legal';
  title?: string;
  description?: string;
}

const { persona = 'homeowner', title, description } = Astro.props;
---

<div class="contextual-cta my-10 bg-navy-900 text-white rounded-2xl p-6 sm:p-8 border border-gold-500/40 shadow-card relative overflow-hidden">
  <!-- Gold ambient glow -->
  <div class="absolute -bottom-10 -right-10 w-48 h-48 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>

  {persona === 'homeowner' && (
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="badge-gold">Homeowner Settlement Toolkit</span>
        <h3 class="font-serif font-bold text-xl sm:text-2xl text-white">
          {title || 'Planning Your Closing in Wise County?'}
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
          {description || 'Calculate your exact Texas title insurance fees down to the dollar, or pre-fill your Texas Homestead Exemption (Form 50-114) with direct county routing.'}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
        <a href="/tools/tdi-rate-calculator" class="btn-gold text-xs w-full sm:w-auto">
          <Calculator className="w-4 h-4 mr-1.5" /> TDI Rate Calculator
        </a>
        <a href="/tools/homestead-exemption-assistant" class="btn-outline text-xs text-slate-900 w-full sm:w-auto">
          Homestead Assistant →
        </a>
      </div>
    </div>
  )}

  {persona === 'realtor' && (
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="badge-gold">Realtor Pro Intake Portal</span>
        <h3 class="font-serif font-bold text-xl sm:text-2xl text-white">
          {title || 'Under Contract? Open Title with Zero Friction'}
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
          {description || 'Drop your signed purchase agreement into our intake engine. We extract property data, assign your dedicated escrow officer, and send instant confirmation.'}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
        <a href="/order" class="btn-gold text-xs w-full sm:w-auto">
          <FileText className="w-4 h-4 mr-1.5" /> 1-Click Contract Drop
        </a>
        <a href="/tools/t47-affidavit-wizard" class="btn-outline text-xs text-slate-900 w-full sm:w-auto">
          T-47 Generator →
        </a>
      </div>
    </div>
  )}

  {persona === 'ag-ranch' && (
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="badge-gold">Rural Acreage & Mineral Diligence</span>
        <h3 class="font-serif font-bold text-xl sm:text-2xl text-white">
          {title || 'Analyzing Rural Acreage or Mineral Severance?'}
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
          {description || 'Inspect Barnett Shale RRC oil/gas wellheads, floodplains, and water district boundaries on our North Texas GIS Due Diligence Map.'}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
        <a href="/tools/property-due-diligence-map" class="btn-gold text-xs w-full sm:w-auto">
          <Compass className="w-4 h-4 mr-1.5" /> North Texas GIS Map
        </a>
        <a href="/knowledge-hub/ag-ranch" class="btn-outline text-xs text-slate-900 w-full sm:w-auto">
          Ag & Ranch Hub →
        </a>
      </div>
    </div>
  )}

  {persona === 'commercial' && (
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="badge-gold">Commercial & Subdivision Services</span>
        <h3 class="font-serif font-bold text-xl sm:text-2xl text-white">
          {title || 'Complex Commercial Subdivision or 1031 Exchange?'}
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
          {description || 'Our commercial closing team coordinates ALTA endorsements, phased lot takedowns, MUD/PID disclosures, and title plant examination.'}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
        <a href="/services/closings-escrow" class="btn-gold text-xs w-full sm:w-auto">
          Commercial Closings
        </a>
        <a href="/tools/tdi-rate-calculator" class="btn-outline text-xs text-slate-900 w-full sm:w-auto">
          Endorsement Calculator →
        </a>
      </div>
    </div>
  )}

  {persona === 'legal' && (
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2">
        <span class="badge-gold">Curative Legal & Underwriting Triage</span>
        <h3 class="font-serif font-bold text-xl sm:text-2xl text-white">
          {title || 'Encountering an Unreleased Lien, Heirship, or Title Cloud?'}
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
          {description || 'Get rapid legal analysis and custom deed preparation through our in-house partnership with The Berry White Law Firm, PLLC.'}
        </p>
      </div>
      <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
        <a href="/tools/deal-doctor" class="btn-gold text-xs w-full sm:w-auto">
          <Scale className="w-4 h-4 mr-1.5" /> Deal Doctor Triage
        </a>
        <a href="/services/curative-legal-counsel" class="btn-outline text-xs text-slate-900 w-full sm:w-auto">
          Curative Counsel →
        </a>
      </div>
    </div>
  )}
</div>
