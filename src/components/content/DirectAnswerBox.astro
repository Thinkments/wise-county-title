---
import { Sparkles, CheckCircle2 } from 'lucide-react';

interface Props {
  summary: string;
  bulletPoints?: string[];
}

const { summary, bulletPoints = [] } = Astro.props;
---

<section 
  class="geo-direct-answer my-6 bg-gradient-to-br from-navy-900 via-navy-900 to-navy-950 text-white rounded-2xl p-6 border border-gold-500/30 shadow-card relative overflow-hidden"
  aria-label="Executive Direct Answer Summary"
>
  <!-- Subtle gold decorative glow -->
  <div class="absolute -top-12 -right-12 w-40 h-40 bg-gold-500/10 rounded-full blur-3xl pointer-events-none"></div>
  
  <div class="flex items-center gap-2 mb-3">
    <div class="p-1.5 rounded-lg bg-gold-500/20 text-gold-400 border border-gold-500/40">
      <Sparkles className="w-4 h-4" />
    </div>
    <span class="text-xs font-bold text-gold-400 uppercase tracking-wider">
      Quick Answer • Executive Summary
    </span>
  </div>

  <p class="text-sm sm:text-base font-normal leading-relaxed text-slate-100">
    {summary}
  </p>

  {bulletPoints.length > 0 && (
    <ul class="mt-4 pt-4 border-t border-navy-800 space-y-2 text-xs sm:text-sm text-slate-300">
      {bulletPoints.map((point) => (
        <li class="flex items-start gap-2">
          <CheckCircle2 className="w-4 h-4 text-gold-400 shrink-0 mt-0.5" />
          <span>{point}</span>
        </li>
      ))}
    </ul>
  )}
</section>
