---
import { ShieldCheck, Scale, ExternalLink } from 'lucide-react';

interface Props {
  authorName?: string;
  reviewedByName?: string;
  verifiedDate?: string;
}

const {
  authorName = 'Ken R. Dodson',
  reviewedByName = 'Berry White, J.D.',
  verifiedDate = 'August 2026',
} = Astro.props;
---

<div class="legal-review-badge bg-white rounded-xl border border-slate-200 p-4 shadow-sm my-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
  <div class="flex items-start gap-3">
    <div class="p-2 rounded-lg bg-navy-50 text-navy-900 border border-navy-100 shrink-0">
      <Scale className="w-5 h-5 text-gold-600" />
    </div>
    <div class="text-xs text-slate-600">
      <div class="flex items-center gap-1.5 font-bold text-navy-900 text-sm">
        <ShieldCheck className="w-4 h-4 text-emerald-600" />
        <span>Texas Statutory & Legal Compliance Verified</span>
      </div>
      <p class="mt-1">
        Written by <strong class="text-slate-900">{authorName}</strong> • Legally vetted & fact-checked by 
        <a 
          href="https://www.hbwhitelaw.com/our-attorneys" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-semibold text-navy-900 hover:text-gold-600 underline inline-flex items-center gap-0.5 ml-1"
        >
          {reviewedByName} (State Bar #24060820)
        </a> 
        at 
        <a 
          href="https://www.hbwhitelaw.com/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-semibold text-navy-900 hover:text-gold-600 underline inline-flex items-center gap-0.5 ml-1"
        >
          The Berry White Law Firm, PLLC <ExternalLink className="w-3 h-3 inline text-slate-400" />
        </a>.
      </p>
    </div>
  </div>

  <div class="text-[11px] font-medium text-slate-500 bg-slate-50 px-3 py-1.5 rounded-lg border border-slate-200 shrink-0">
    Last Legal Audit: <span class="text-slate-800 font-semibold">{verifiedDate}</span>
  </div>
</div>
