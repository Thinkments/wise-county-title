---
import { ShieldAlert, PhoneCall, ChevronRight } from 'lucide-react';
---

<div class="bg-navy-950 text-white text-xs border-b border-navy-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex flex-col sm:flex-row items-center justify-between gap-2">
    <div class="flex items-center gap-2">
      <span class="inline-flex items-center gap-1 font-bold text-gold-400 bg-gold-950/60 border border-gold-600/40 px-2 py-0.5 rounded text-[11px] uppercase tracking-wider">
        <ShieldAlert className="w-3.5 h-3.5 text-gold-400" />
        Wire Fraud Warning
      </span>
      <p class="text-slate-300 line-clamp-1">
        Wise County Title will <strong class="text-white">never</strong> email you changed wiring instructions. Always verbally confirm before sending funds.
      </p>
    </div>
    <div class="flex items-center gap-4 shrink-0 font-medium">
      <a href="tel:+19406273581" class="text-slate-300 hover:text-gold-300 flex items-center gap-1 transition-colors">
        <PhoneCall className="w-3 h-3 text-gold-400" />
        Decatur: (940) 627-3581
      </a>
      <span class="text-navy-700 hidden sm:inline">|</span>
      <a href="tel:+19406833581" class="text-slate-300 hover:text-gold-300 flex items-center gap-1 transition-colors">
        <PhoneCall className="w-3 h-3 text-gold-400" />
        Bridgeport: (940) 683-3581
      </a>
      <a href="/resources/cyber-security" class="text-gold-400 hover:text-gold-300 underline text-[11px] flex items-center gap-0.5 ml-1">
        Security Protocols <ChevronRight className="w-3 h-3 inline" />
      </a>
    </div>
  </div>
</div>
