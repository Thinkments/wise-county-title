---
import { MapPin, Phone, Mail, Clock, ShieldCheck, Scale, ExternalLink, Award } from 'lucide-react';
---

<footer class="bg-navy-950 text-slate-300 pt-16 pb-12 border-t-4 border-gold-500">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Strategic Partnership Banner with H.B. White Law -->
    <div class="bg-navy-900/90 rounded-2xl p-6 sm:p-8 border border-navy-800 mb-12 shadow-inner flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="flex items-start gap-4">
        <div class="p-3 bg-gold-500/10 rounded-xl border border-gold-500/30 text-gold-400 shrink-0">
          <Scale className="w-8 h-8" />
        </div>
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-semibold text-gold-400 uppercase tracking-wider mb-1">
            <span>In-House Legal Partnership</span>
            <span class="text-navy-600">•</span>
            <span>Zero-Delay Curative Action</span>
          </div>
          <h3 class="font-serif font-bold text-white text-xl">The Berry White Law Firm, PLLC</h3>
          <p class="text-sm text-slate-400 max-w-2xl mt-1">
            Co-located at our Bridgeport office. Attorney Herman Berry White IV, J.D. (Texas Bar #24060820) provides immediate in-house deed preparation, probate resolution, heirship affidavits, and title defect curative support.
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a 
          href="https://www.hbwhitelaw.com/" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-navy-800 hover:bg-navy-700 border border-gold-500/40 transition-colors"
        >
          Visit HBWhiteLaw.com <ExternalLink className="w-3.5 h-3.5 text-gold-400" />
        </a>
        <a 
          href="/services/curative-legal-counsel" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold text-navy-950 bg-gold-500 hover:bg-gold-400 transition-colors"
        >
          Curative Services
        </a>
      </div>
    </div>

    <!-- Main Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-navy-800 text-sm">
      
      <!-- Col 1: About & Heritage -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <img 
            src="/images/wise-title-owl-logo.svg" 
            alt="Wise County Title Company" 
            class="h-12 w-auto brightness-0 invert"
          />
        </div>

        <p class="text-slate-400 text-xs leading-relaxed max-w-sm">
          Wise County's trusted title partner for over 148 years. Owner and operator of the only private, fully indexed sovereignty title plant open to the public in Wise County, Texas.
        </p>
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-navy-900 border border-navy-800 text-[11px] text-slate-300">
            <Award className="w-3 h-3 text-gold-400" /> 6 National Underwriters
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-navy-900 border border-navy-800 text-[11px] text-slate-300">
            <ShieldCheck className="w-3 h-3 text-gold-400" /> ALTA Best Practices
          </span>
          <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-navy-900 border border-navy-800 text-[11px] text-slate-300">
            ★ 4.9 Rating (217+ Reviews)
          </span>
        </div>
      </div>

      <!-- Col 2: Decatur Office -->
      <div class="space-y-3">
        <div class="font-semibold text-white text-sm uppercase tracking-wider text-gold-400">Decatur Headquarters</div>
        <div class="space-y-2 text-xs text-slate-400">
          <p class="flex items-start gap-2">
            <MapPin className="w-4 h-4 text-gold-400 shrink-0 mt-0.5" />
            <span>405 Park West Court<br/>Decatur, TX 76234</span>
          </p>
          <p class="flex items-center gap-2">
            <Phone className="w-4 h-4 text-gold-400 shrink-0" />
            <a href="tel:+19406273581" class="hover:text-white transition-colors">(940) 627-3581</a>
          </p>
          <p class="flex items-center gap-2">
            <Mail className="w-4 h-4 text-gold-400 shrink-0" />
            <a href="mailto:orderdesk@wisetitle.com" class="hover:text-white transition-colors">orderdesk@wisetitle.com</a>
          </p>
          <p class="flex items-center gap-2">
            <Clock className="w-4 h-4 text-gold-400 shrink-0" />
            <span>Mon–Fri: 8:00 AM – 5:00 PM</span>
          </p>
        </div>
        <a href="/locations/decatur-tx" class="inline-block text-xs text-gold-400 hover:text-gold-300 font-medium pt-1">
          Decatur Office Details & Map →
        </a>
      </div>

      <!-- Col 3: Bridgeport Office -->
      <div class="space-y-3">
        <div class="font-semibold text-white text-sm uppercase tracking-wider text-gold-400">Bridgeport Branch</div>
        <div class="space-y-2 text-xs text-slate-400">
          <p class="flex items-start gap-2">
            <MapPin className="w-4 h-4 text-gold-400 shrink-0 mt-0.5" />
            <span>1602 Halsell Street<br/>Bridgeport, TX 76426</span>
          </p>
          <p class="flex items-center gap-2">
            <Phone className="w-4 h-4 text-gold-400 shrink-0" />
            <a href="tel:+19406833581" class="hover:text-white transition-colors">(940) 683-3581</a>
          </p>
          <p class="flex items-center gap-2">
            <Mail className="w-4 h-4 text-gold-400 shrink-0" />
            <a href="mailto:fastresponse@wisetitle.com" class="hover:text-white transition-colors">fastresponse@wisetitle.com</a>
          </p>
          <p class="flex items-center gap-2">
            <Clock className="w-4 h-4 text-gold-400 shrink-0" />
            <span>Mon–Fri: 8:00 AM – 5:00 PM</span>
          </p>
        </div>
        <a href="/locations/bridgeport-tx" class="inline-block text-xs text-gold-400 hover:text-gold-300 font-medium pt-1">
          Bridgeport Office & Legal Team →
        </a>
      </div>

      <!-- Col 4: Quick Links -->
      <div class="space-y-3">
        <div class="font-semibold text-white text-sm uppercase tracking-wider text-gold-400">Tools & Knowledge</div>
        <ul class="space-y-2 text-xs text-slate-400">
          <li><a href="/tools/tdi-rate-calculator" class="hover:text-white transition-colors">TDI Title Rate Calculator</a></li>
          <li><a href="/tools/t47-affidavit-wizard" class="hover:text-white transition-colors">T-47 Affidavit Generator</a></li>
          <li><a href="/tools/homestead-exemption-assistant" class="hover:text-white transition-colors">Homestead Exemption (50-114)</a></li>
          <li><a href="/tools/property-due-diligence-map" class="hover:text-white transition-colors">North Texas GIS Map</a></li>
          <li><a href="/knowledge-hub" class="hover:text-white transition-colors">300-Page Research Hub</a></li>
          <li><a href="/resources/cyber-security" class="hover:text-white transition-colors">Wire Fraud Security Center</a></li>
          <li><a href="/order" class="hover:text-white transition-colors text-gold-400 font-semibold">1-Click AI Contract Drop</a></li>
        </ul>
      </div>

    </div>

    <!-- Underwriters & Accreditations Row -->
    <div class="py-8 border-b border-navy-800 text-xs text-slate-400">
      <div class="text-center font-semibold uppercase tracking-wider text-slate-400 mb-4">
        Underwritten by America's Leading National Title Insurers
      </div>
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-slate-300 font-medium">
        <span class="hover:text-white transition-colors">First American Title</span>
        <span>•</span>
        <span class="hover:text-white transition-colors">Fidelity National Title</span>
        <span>•</span>
        <span class="hover:text-white transition-colors">Stewart Title Guaranty</span>
        <span>•</span>
        <span class="hover:text-white transition-colors">Old Republic National Title</span>
        <span>•</span>
        <span class="hover:text-white transition-colors">Chicago Title Insurance</span>
        <span>•</span>
        <span class="hover:text-white transition-colors">Commonwealth Land Title</span>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>© {new Date().getFullYear()} Wise County Title Company, Inc. All rights reserved. The Wise Choice Since 1878.</p>
      <div class="flex flex-wrap items-center gap-4 text-xs">
        <a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a>
        <span>•</span>
        <a href="/terms-of-service" class="hover:text-white transition-colors">Terms of Service</a>
        <span>•</span>
        <a href="/accessibility" class="hover:text-white transition-colors">Accessibility (WCAG 2.2 AA)</a>
        <span>•</span>
        <a href="/resources/real-estate-dictionary" class="hover:text-white transition-colors">Title Dictionary</a>
      </div>
    </div>

  </div>
</footer>
