---
import { ChevronRight, Home } from 'lucide-react';

interface Crumb {
  name: string;
  url: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumbs" class="py-3 px-4 sm:px-0 text-xs font-medium text-slate-500">
  <ol class="flex items-center flex-wrap gap-1.5 list-none p-0 m-0">
    <li class="inline-flex items-center">
      <a href="/" class="hover:text-navy-900 inline-flex items-center gap-1 transition-colors">
        <Home className="w-3.5 h-3.5 text-slate-400" />
        <span>Home</span>
      </a>
    </li>
    
    {items.map((crumb, idx) => (
      <li class="inline-flex items-center gap-1.5">
        <ChevronRight className="w-3.5 h-3.5 text-slate-400 shrink-0" />
        {idx === items.length - 1 ? (
          <span class="text-navy-900 font-semibold truncate max-w-[200px] sm:max-w-xs" aria-current="page">
            {crumb.name}
          </span>
        ) : (
          <a href={crumb.url} class="hover:text-navy-900 transition-colors">
            {crumb.name}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>
