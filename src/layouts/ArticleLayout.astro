---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/common/Breadcrumbs.astro';
import DirectAnswerBox from '../components/content/DirectAnswerBox.astro';
import LegalReviewBadge from '../components/content/LegalReviewBadge.astro';
import TableOfContents from '../components/content/TableOfContents.astro';
import ContextualCta from '../components/content/ContextualCta.astro';
import { Clock, Calendar, BookOpen, ArrowLeft, ArrowRight, Share2, Printer, ShieldCheck, Scale, AlertCircle, Sparkles } from 'lucide-react';

interface Props {
  title: string;
  description: string;
  pillar: string;
  pillarName: string;
  pillarSlug: string;
  persona?: 'homeowner' | 'realtor' | 'ag-ranch' | 'commercial' | 'legal';
  readingTimeMinutes?: number;
  datePublished?: string;
  dateModified?: string;
  authorName?: string;
  reviewedByName?: string;
  directAnswerSummary: string;
  directAnswerBullets?: string[];
  headings?: Array<{ depth: number; slug: string; text: string }>;
  relatedArticles?: Array<{ title: string; url: string; category: string }>;
}

const {
  title,
  description,
  pillar,
  pillarName,
  pillarSlug,
  persona = 'homeowner',
  readingTimeMinutes = 6,
  datePublished = '2026-08-15',
  dateModified = '2026-08-20',
  authorName = 'Ken R. Dodson',
  reviewedByName = 'Berry White, J.D.',
  directAnswerSummary,
  directAnswerBullets = [],
  headings = [],
  relatedArticles = [],
} = Astro.props;

const breadcrumbItems = [
  { name: 'Knowledge Hub', url: '/knowledge-hub' },
  { name: pillarName, url: `/knowledge-hub/${pillarSlug}` },
  { name: title, url: Astro.url.pathname },
];
---

<BaseLayout
  title={`${title} | Wise County Title Knowledge Hub`}
  description={description}
  pageType="article"
  datePublished={datePublished}
  dateModified={dateModified}
  authorName={authorName}
  reviewedByName={reviewedByName}
  breadcrumbs={breadcrumbItems}
>
  <div class="bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <Breadcrumbs items={breadcrumbItems} />
    </div>
  </div>

  <article class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    
    <!-- Article Header -->
    <header class="max-w-4xl space-y-4 mb-8">
      
      <!-- Legislative & Temporal Freshness Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-navy-900 text-gold-300 border border-gold-500/40 shadow-sm">
        <Sparkles class="w-3.5 h-3.5 text-gold-400" />
        <span>Verified by In-House Counsel | Reflecting 88th & 89th Texas Legislative Updates | 2026 Edition</span>
      </div>

      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
        <a href={`/knowledge-hub/${pillarSlug}`} class="badge-gold hover:bg-gold-200 transition-colors">
          {pillarName}
        </a>
        <span class="text-slate-300">•</span>
        <span class="inline-flex items-center gap-1 text-slate-500">
          <Clock className="w-3.5 h-3.5 text-slate-400" />
          {readingTimeMinutes} min read
        </span>
        <span class="text-slate-300">•</span>
        <span class="inline-flex items-center gap-1 text-slate-500">
          <Calendar className="w-3.5 h-3.5 text-slate-400" />
          Updated {dateModified}
        </span>
      </div>

      <h1 class="font-serif font-bold text-navy-950 text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-tight">
        {title}
      </h1>

      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
        {description}
      </p>

      <!-- GEO Direct Answer Executive Summary (AI Overview / Search Engine Ready) -->
      <DirectAnswerBox 
        summary={directAnswerSummary}
        bulletPoints={directAnswerBullets}
      />

      <!-- E-E-A-T Legal Compliance Badge -->
      <LegalReviewBadge 
        authorName={authorName}
        reviewedByName={reviewedByName}
        verifiedDate={dateModified}
      />
    </header>

    <!-- Main Content Layout Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Article Body -->
      <div class="lg:col-span-8">
        
        <div class="prose prose-slate prose-lg max-w-none text-slate-800 leading-relaxed space-y-6">
          <slot />
        </div>

        <!-- Mandatory YMYL Legal & Tax Safe Harbor Disclaimer Block -->
        <div class="mt-10 p-5 rounded-2xl bg-slate-100 border border-slate-300/80 text-xs text-slate-600 space-y-2">
          <div class="font-bold text-slate-900 flex items-center gap-1.5 uppercase tracking-wider text-[11px]">
            <Scale class="w-4 h-4 text-navy-900" />
            <span>Legal & Regulatory Safe Harbor Disclosure</span>
          </div>
          <p class="leading-relaxed">
            <strong>Legal & Tax Disclaimer:</strong> The educational content published by Wise County Title Company is intended solely for general informational purposes and does not establish an attorney-client relationship or constitute formal legal or tax counsel. Curative title legal services, custom deed drafting, heirship affidavits, and probate representation are conducted independently through <strong>The Berry White Law Firm, PLLC</strong> (Bridgeport, TX — Texas State Bar #24060820). For formal legal representation, please contact our in-house attorney directly at (940) 683-3581.
          </p>
          <p class="leading-relaxed text-[11px] text-slate-500 pt-1 border-t border-slate-200">
            <strong>TDI Promulgated Rates:</strong> All Texas title insurance premium rates and endorsement fees are strictly promulgated by the Texas Department of Insurance (TDI) pursuant to the Texas Insurance Code Chapter 2703 and Basic Manual Rule R-1.
          </p>
        </div>

        <!-- Persona Lead Generation Funnel -->
        <ContextualCta persona={persona} />

        <!-- Related Research Hub Articles (Contextual Mesh) -->
        {relatedArticles.length > 0 && (
          <div class="mt-12 pt-8 border-t border-slate-200">
            <h2 class="font-serif font-bold text-navy-950 text-xl sm:text-2xl mb-4 flex items-center gap-2">
              <BookOpen className="w-5 h-5 text-gold-600" />
              <span>Related Research Guides in {pillarName}</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {relatedArticles.map((rel) => (
                <a 
                  href={rel.url}
                  class="p-5 rounded-2xl bg-white border border-slate-200 hover:border-navy-900 shadow-sm hover:shadow-card transition-all group block"
                >
                  <span className="text-[11px] font-bold text-gold-600 uppercase tracking-wider block mb-1">
                    {rel.category}
                  </span>
                  <div class="font-serif font-bold text-navy-900 text-sm group-hover:text-gold-700 transition-colors">
                    {rel.title}
                  </div>
                  <span class="text-xs text-slate-500 inline-flex items-center gap-1 mt-2">
                    Read Guide <ArrowRight className="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}

      </div>

      <!-- Sticky Right Sidebar -->
      <aside class="lg:col-span-4 space-y-6">
        
        <div class="sticky top-28 space-y-6">
          
          <!-- Table of Contents -->
          {headings.length > 0 && (
            <TableOfContents headings={headings} />
          )}

          <!-- Quick Action Card -->
          <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
            <div class="font-serif font-bold text-navy-900 text-base flex items-center gap-2">
              <ShieldCheck className="w-5 h-5 text-gold-600" />
              <span>Wise County Title Services</span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Have questions regarding this topic on a pending contract? Connect directly with our closing and underwriting team.
            </p>
            <div class="space-y-2">
              <a href="/tools/tdi-rate-calculator" class="w-full btn-gold text-xs flex items-center justify-center gap-1.5 py-2.5">
                Calculate Title Policy Fees
              </a>
              <a href="/tools/deal-doctor" class="w-full btn-outline text-xs flex items-center justify-center gap-1.5 py-2.5">
                Ask Legal Counsel (Deal Doctor)
              </a>
              <a href="tel:+19406273581" class="w-full text-center text-xs text-slate-600 hover:text-navy-900 block py-1 font-medium">
                📞 Call Decatur: (940) 627-3581
              </a>
            </div>
          </div>

          <!-- Sovereignty Plant Highlight -->
          <div class="bg-navy-900 text-white rounded-2xl p-5 border border-navy-800 space-y-2 text-xs">
            <div class="font-bold text-gold-400 uppercase tracking-wider text-[10px]">Title Plant Authority</div>
            <div class="font-serif font-bold text-sm">The Only Sovereignty Plant in Wise County</div>
            <p class="text-slate-300 text-[11px] leading-relaxed">
              Records dating from original land patents and early 1900s tract books to present day.
            </p>
            <a href="/services/public-title-plant" class="text-gold-400 hover:text-gold-300 underline font-semibold block pt-1">
              Explore Title Plant Records →
            </a>
          </div>

        </div>

      </aside>

    </div>

  </article>
</BaseLayout>
