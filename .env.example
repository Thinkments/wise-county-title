# Wise County Title Project Configuration Template

# General Environment Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=WiseCountyTitle
PORT=8000
HOST=127.0.0.1

# Texas Title Insurance Defaults (TDI)
DEFAULT_COUNTY=Wise
DEFAULT_COUNTY_SEAT=Decatur
DEFAULT_ESCROW_FEE=450.00
DEFAULT_TAX_CERT_FEE=65.00
DEFAULT_E_RECORDING_FEE=10.00

# Database & Storage Settings
DATA_STORAGE_PATH=./data
DATABASE_URL=sqlite:///./data/wise_county_title.db

# API Integrations (Optional)
# WISE_CAD_API_KEY=
# TITLE_PLANT_API_KEY=
# GEMINI_API_KEY=
