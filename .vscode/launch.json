{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Main App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Verify Workspace",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/verify_workspace.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Calculate Rate Sample ($350k)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "args": ["--calc", "--policy-amount", "350000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
